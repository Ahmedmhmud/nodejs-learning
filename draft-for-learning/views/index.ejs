<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YOOOO</title>
</head>
<body>
    <form action="/login" method="POST">
        <input type="text" name="name">
        <input type="text" name="age">
        <input type="submit" value="Submit">
    </form>

    <ul>
        <% for(let user of users) { %>
        <li>
            <%= user.name %> : <%= user.age %>
        </li>
        <% } %>
    </ul>
</body>
</html>